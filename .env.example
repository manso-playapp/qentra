NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_public_publishable_key_optional_alias
NEXT_PUBLIC_APP_URL=https://tu-dominio-publico.com
# Token HTML de Google Search Console para verificar el dominio (opcional).
GOOGLE_SITE_VERIFICATION=google_search_console_verification_token
# Activar sólo después de habilitar Vercel Web Analytics y aprobar su base legal.
# Configurar como 1 únicamente en Production y volver a desplegar.
ALISTA_WEB_ANALYTICS_ENABLED=0
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_optional_for_server_auditing
# Solo backend. Los deploys Preview de Vercel fuerzan la credencial de prueba.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your_production_access_token
MERCADOPAGO_TEST_ACCESS_TOKEN=APP_USR-your_test_access_token
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret
# OAuth de la cuenta receptora de cada evento. Registrar exactamente esta URL
# como redirección permitida en la aplicación de Mercado Pago.
MERCADOPAGO_CLIENT_ID=your_mercadopago_application_id
MERCADOPAGO_CLIENT_SECRET=your_mercadopago_application_secret
MERCADOPAGO_OAUTH_REDIRECT_URI=https://tu-dominio.com/api/mercadopago/oauth/callback
# Base64 de 32 bytes aleatorios. Sólo backend; cifra tokens OAuth y verificadores PKCE.
ALISTA_PAYMENT_CREDENTIALS_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32
ALISTA_OPERATOR_RECOVERY_REDIRECT_URL=https://tu-dominio.com/acceso
ALISTA_SECURITY_OVERRIDE_PIN=define_a_separate_override_pin
ALISTA_SECURITY_SUPERVISOR_PIN=optional_second_pin_for_double_control

# Email delivery via Resend
RESEND_API_KEY=re_xxxxxxxxx
ALISTA_EMAIL_FROM=Alista <invitaciones@tu-dominio.com>

# WhatsApp delivery via Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Preferred for business-initiated invitations: approved template/content SID
TWILIO_WHATSAPP_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional alternatives
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_WHATSAPP_ALLOW_FREEFORM=false
